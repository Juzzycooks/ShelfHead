    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ShelfHead can use Face ID to lock the app when you enable this in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "如果你在“设置”中启用此功能，ShelfHead 可以使用 Face ID 锁定应用。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ShelfHead connects to your Audiobookshelf server, which may be on your local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ShelfHead 会连接到你的 Audiobookshelf 服务器，该服务器可能位于你的本地网络中。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ShelfHead saves the share card you create to your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ShelfHead 会将你创建的分享卡片存储到你的照片图库中。"
          }
        }
      }
    },
    "NSSiriUsageDescription" : {
      "comment" : "Privacy - Siri Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ShelfHead uses Siri so you can ask it to play your audiobooks, including from CarPlay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ShelfHead 使用 Siri，让你可以用语音播放有声书，包括在 CarPlay 中。"
          }
        }
      }
    }
