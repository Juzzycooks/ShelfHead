{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, %lld percent" : {
      "comment" : "VoiceOver label for a watch complication. %1$@ is the book title, %2$lld is the progress percentage.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld percent"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@，百分之 %2$lld"
          }
        }
      }
    },
    "%lld%% · %@" : {
      "comment" : "Watch complication subtitle. %1$lld is the progress percentage, %2$@ is the author.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld%% · %2$@"
          }
        }
      }
    },
    "Continue listening" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "继续收听"
          }
        }
      }
    },
    "Open ShelfHead" : {
