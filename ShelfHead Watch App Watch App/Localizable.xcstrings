      }
    },
    "iPhone out of range" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 不在范围内"
          }
        }
      }
    },
    "“%@” has different progress here than on the server — this Watch is at %@, the server is at %@. Which one should win?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” has different progress here than on the server — this Watch is at %2$@, the server is at %3$@. Which one should win?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%1$@”在这块手表上的进度与服务器不一致：手表为 %2$@，服务器为 %3$@。要以哪一个为准？"
          }
        }
      }
    },
    "“%@” pauses on your iPhone." : {
      "comment" : "Confirmation message; %@ is the title of the book now playing",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@”将在 iPhone 上暂停。"
